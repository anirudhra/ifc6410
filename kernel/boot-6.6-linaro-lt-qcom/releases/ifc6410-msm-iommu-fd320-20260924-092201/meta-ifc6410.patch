 create mode 100644 recipes-kernel/linux/files/0002-iommu-msm-track-a-context-master-per-device-and-IOMM.patch
 create mode 100644 recipes-kernel/linux/files/0003-iommu-msm-use-the-IOMMU-device-for-page-table-allocation.patch
 create mode 100644 recipes-kernel/linux/files/0004-drm-msm-release-ARM-DMA-mapping-before-attaching-own.patch

diff --git a/recipes-kernel/linux/files/0001-ARM-dma-mapping-reset-DMA-ops-before-IOMMU-detach.patch b/recipes-kernel/linux/files/0001-ARM-dma-mapping-reset-DMA-ops-before-IOMMU-detach.patch
new file mode 100644
index 0000000..ecafc13
--- /dev/null
+++ b/recipes-kernel/linux/files/0001-ARM-dma-mapping-reset-DMA-ops-before-IOMMU-detach.patch
@@ -0,0 +1,26 @@
+From de258d1a98b02acb702f2b135b56c84f6105d02e Mon Sep 17 00:00:00 2001
+From: IFC6410 backport scratch <ifc6410-backport@localhost>
+Date: Wed, 23 Sep 2026 22:29:25 -0700
+Subject: [PATCH 1/3] ARM: dma-mapping: reset DMA ops before IOMMU detach
+
+Reset DMA operations before detaching the IOMMU mapping so page-table cleanup uses direct DMA operations rather than interpreting stored physical DMA addresses as IOVAs.
+
+diff --git a/arch/arm/mm/dma-mapping.c b/arch/arm/mm/dma-mapping.c
+index 5409225b4..922f647bb 100644
+--- a/arch/arm/mm/dma-mapping.c
++++ b/arch/arm/mm/dma-mapping.c
+@@ -1703,10 +1703,13 @@ void arm_iommu_detach_device(struct device *dev)
+ 		return;
+ 	}
+ 
++	/* Reset DMA ops before detach so page-table teardown uses the same
++	 * direct ops that mapped them at attach time.
++	 */
++	set_dma_ops(dev, NULL);
+ 	iommu_detach_device(mapping->domain, dev);
+ 	kref_put(&mapping->kref, release_iommu_mapping);
+ 	to_dma_iommu_mapping(dev) = NULL;
+-	set_dma_ops(dev, NULL);
+ 
+ 	pr_debug("Detached IOMMU controller from %s device.\n", dev_name(dev));
+ }
diff --git a/recipes-kernel/linux/files/0002-iommu-msm-track-a-context-master-per-device-and-IOMM.patch b/recipes-kernel/linux/files/0002-iommu-msm-track-a-context-master-per-device-and-IOMM.patch
new file mode 100644
index 0000000..af114a9
--- /dev/null
+++ b/recipes-kernel/linux/files/0002-iommu-msm-track-a-context-master-per-device-and-IOMM.patch
@@ -0,0 +1,50 @@
+From 555971c2fd2d5930fa0e8e6883909e7d419593ee Mon Sep 17 00:00:00 2001
+From: IFC6410 backport scratch <ifc6410-backport@localhost>
+Date: Wed, 23 Sep 2026 22:32:57 -0700
+Subject: [PATCH 2/3] iommu/msm: track a context master per device and IOMMU
+
+A context master belongs to one device on one MSM IOMMU instance. Look it up in the target instance context list and allocate it only when missing, avoiding a stale per-device private cache across deferred multi-IOMMU probing.
+
+diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
+index 79d89bad5..9ab6d54cc 100644
+--- a/drivers/iommu/msm_iommu.c
++++ b/drivers/iommu/msm_iommu.c
+@@ -587,24 +587,27 @@ static int insert_iommu_master(struct device *dev,
+ 				struct msm_iommu_dev **iommu,
+ 				struct of_phandle_args *spec)
+ {
+-	struct msm_iommu_ctx_dev *master = dev_iommu_priv_get(dev);
++	struct msm_iommu_ctx_dev *master;
+ 	int sid;
+ 
+-	if (list_empty(&(*iommu)->ctx_list)) {
+-		master = kzalloc(sizeof(*master), GFP_ATOMIC);
+-		if (!master) {
+-			dev_err(dev, "Failed to allocate iommu_master\n");
+-			return -ENOMEM;
+-		}
+-		master->of_node = dev->of_node;
+-		list_add(&master->list, &(*iommu)->ctx_list);
+-		dev_iommu_priv_set(dev, master);
++	/* A master describes one device on one IOMMU instance. */
++	list_for_each_entry(master, &(*iommu)->ctx_list, list)
++		if (master->of_node == dev->of_node)
++			goto add_sid;
++
++	master = kzalloc(sizeof(*master), GFP_ATOMIC);
++	if (!master) {
++		dev_err(dev, "Failed to allocate iommu_master\n");
++		return -ENOMEM;
+ 	}
++	master->of_node = dev->of_node;
++	list_add(&master->list, &(*iommu)->ctx_list);
+ 
++add_sid:
+ 	for (sid = 0; sid < master->num_mids; sid++)
+ 		if (master->mids[sid] == spec->args[0]) {
+-			dev_warn(dev, "Stream ID 0x%x repeated; ignoring\n",
+-				 sid);
++			dev_dbg(dev, "Stream ID 0x%x repeated; ignoring\n",
++				sid);
+ 			return 0;
+ 		}
diff --git a/recipes-kernel/linux/files/0003-iommu-msm-use-the-IOMMU-device-for-page-table-allocation.patch b/recipes-kernel/linux/files/0003-iommu-msm-use-the-IOMMU-device-for-page-table-allocation.patch
new file mode 100644
index 0000000..7e36998
--- /dev/null
+++ b/recipes-kernel/linux/files/0003-iommu-msm-use-the-IOMMU-device-for-page-table-allocation.patch
@@ -0,0 +1,61 @@
+From: IFC6410 upstream backport <ifc6410-backport@localhost>
+Subject: [PATCH] iommu/msm: use the IOMMU device for page table allocation
+
+Backport upstream v2 logic. Allocate MSM IOMMU page tables through the
+actual IOMMU device rather than through the client GPU/display device.
+
+diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
+index 109688d69e50..15220d79ece3 100644
+--- a/drivers/iommu/msm_iommu.c
++++ b/drivers/iommu/msm_iommu.c
+@@ -42,7 +42,6 @@ struct msm_priv {
+ 	struct iommu_domain domain;
+ 	struct io_pgtable_cfg	cfg;
+ 	struct io_pgtable_ops	*iop;
+-	struct device		*dev;
+ 	spinlock_t		pgtlock; /* pagetable lock */
+ };
+ 
+@@ -336,7 +335,8 @@ static void msm_iommu_domain_free(struct iommu_domain *domain)
+ 	spin_unlock_irqrestore(&msm_iommu_lock, flags);
+ }
+ 
+-static int msm_iommu_domain_config(struct msm_priv *priv)
++static int msm_iommu_domain_config(struct msm_priv *priv,
++				   struct msm_iommu_dev *iommu)
+ {
+ 	spin_lock_init(&priv->pgtlock);
+ 
+@@ -345,12 +345,12 @@ static int msm_iommu_domain_config(struct msm_priv *priv)
+ 		.ias = 32,
+ 		.oas = 32,
+ 		.tlb = &msm_iommu_flush_ops,
+-		.iommu_dev = priv->dev,
++		.iommu_dev = iommu->dev,
+ 	};
+ 
+ 	priv->iop = alloc_io_pgtable_ops(ARM_V7S, &priv->cfg, priv);
+ 	if (!priv->iop) {
+-		dev_err(priv->dev, "Failed to allocate pgtable\n");
++		dev_err(iommu->dev, "Failed to allocate pgtable\n");
+ 		return -EINVAL;
+ 	}
+ 
+@@ -400,8 +400,15 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
+ 	struct msm_priv *priv = to_msm_priv(domain);
+ 	struct msm_iommu_ctx_dev *master;
+ 
+-	priv->dev = dev;
+-	msm_iommu_domain_config(priv);
++	spin_lock_irqsave(&msm_iommu_lock, flags);
++	iommu = find_iommu_for_dev(dev);
++	spin_unlock_irqrestore(&msm_iommu_lock, flags);
++	if (!iommu)
++		return -ENODEV;
++
++	ret = msm_iommu_domain_config(priv, iommu);
++	if (ret)
++		return ret;
+ 
+ 	spin_lock_irqsave(&msm_iommu_lock, flags);
+ 	list_for_each_entry(iommu, &qcom_iommu_devices, dev_node) {
diff --git a/recipes-kernel/linux/files/0004-drm-msm-release-ARM-DMA-mapping-before-attaching-own.patch b/recipes-kernel/linux/files/0004-drm-msm-release-ARM-DMA-mapping-before-attaching-own.patch
new file mode 100644
index 0000000..c1ba2cb
--- /dev/null
+++ b/recipes-kernel/linux/files/0004-drm-msm-release-ARM-DMA-mapping-before-attaching-own.patch
@@ -0,0 +1,49 @@
+From 692887281bd44e5c0ef96a48cf4accbd46f1f31e Mon Sep 17 00:00:00 2001
+From: IFC6410 backport scratch <ifc6410-backport@localhost>
+Date: Wed, 23 Sep 2026 22:34:25 -0700
+Subject: [PATCH 3/3] drm/msm: release ARM DMA mapping before attaching own
+ domain
+
+On ARM32, the architecture DMA setup may have already attached a mapping domain to the device IOMMU group. Detach and release that mapping before attaching the MSM-managed domain, avoiding an attach failure with -EBUSY.
+
+diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
+index 5cc8d358c..12238b103 100644
+--- a/drivers/gpu/drm/msm/msm_iommu.c
++++ b/drivers/gpu/drm/msm/msm_iommu.c
+@@ -6,6 +6,11 @@
+ 
+ #include <linux/adreno-smmu-priv.h>
+ #include <linux/io-pgtable.h>
++
++#if IS_ENABLED(CONFIG_ARM_DMA_USE_IOMMU)
++#include <asm/dma-iommu.h>
++#endif
++
+ #include "msm_drv.h"
+ #include "msm_mmu.h"
+ 
+@@ -379,6 +384,9 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
+ {
+ 	struct iommu_domain *domain;
+ 	struct msm_iommu *iommu;
++#if IS_ENABLED(CONFIG_ARM_DMA_USE_IOMMU)
++	struct dma_iommu_mapping *mapping;
++#endif
+ 	int ret;
+ 
+ 	domain = iommu_domain_alloc(dev->bus);
+@@ -398,6 +406,14 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
+ 
+ 	atomic_set(&iommu->pagetables, 0);
+ 
++#if IS_ENABLED(CONFIG_ARM_DMA_USE_IOMMU)
++	mapping = to_dma_iommu_mapping(dev);
++	if (mapping) {
++		arm_iommu_detach_device(dev);
++		arm_iommu_release_mapping(mapping);
++	}
++#endif
++
+ 	ret = iommu_attach_device(iommu->domain, dev);
+ 	if (ret) {
+ 		iommu_domain_free(domain);
